# Establish the actual physical source condition
capture_source_state(observer, source_state):function:abstract -> SourceStateResult {

    # Measurement device does not yet exist
    measurement_result = false

    if (!measurement_result) {

        ret SourceStateResult(
            valid = false,
            failure_reason = "Measurement apparatus does not exist.",
            measured_variance = null,
            verification_details = "Failed to capture source state."
        );
    }

    ret SourceStateResult(
        valid = true,
        failure_reason = null,
        measured_variance = null,
        verification_details = "Observer source state captured."
    );
}

