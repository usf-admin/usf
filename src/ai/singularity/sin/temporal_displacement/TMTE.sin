# Account for the physical stress-energy/momentum budget. Account for the physical energy, momentum, angular momentum, and other relevant conserved quantities.
verify_conservation_accounting(source_state, destination_state, field_configuration, transition_geometry):function:abstract -> ConservationResult {

    # Measurement device does not yet exist
    measurement_result = false

